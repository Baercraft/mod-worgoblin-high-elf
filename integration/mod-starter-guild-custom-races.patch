+ // Resolve custom races through the core's canonical race -> team mapping.
+ TeamId const teamId = Player::TeamIdForRace(player->getRace());
+ Guild* guild = sGuildMgr->GetGuildById(teamId == TEAM_ALLIANCE ? GUILD_ID_ALLIANCE : GUILD_ID_HORDE);
+
+ // Some first-login/custom-race combinations can reach this hook with a stale
+ // non-zero player guild field although there is no actual membership. Keep a
+ // real membership intact, but clear only inconsistent state so AddMember can
+ // create the correct guild_member row.
+ if (player->GetGuildId() != 0)
+ {
+     Guild* currentGuild = sGuildMgr->GetGuildById(player->GetGuildId());
+     if (currentGuild && currentGuild->GetMember(player->GetGUID()))
+         return;
+     player->SetInGuild(0);
+ }
 
  // If a guild is present, assign the character to the guild; otherwise skip assignment.
  if (!guild)
