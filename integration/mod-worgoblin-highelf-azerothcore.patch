@@ -1393,20 +1393,49 @@ void WorldSession::HandleSetPlayerDeclinedNames(WorldPacket& recvData)
 void WorldSession::HandleAlterAppearance(WorldPacket& recvData)
 {
     LOG_DEBUG("network", "CMSG_ALTER_APPEARANCE");
+
+    // Custom-race barber compatibility. The real race is never changed.
+    // We merely accept appearance styles from a compatible base race as a
+    // fallback when a custom-race client patch uses those barber entries.
+    // Custom-race-specific BarberShopStyle rows remain valid as well.
+    uint8 const playerRace = _player->getRace();
+    uint8 barberBaseRace = playerRace;
+    switch (playerRace)
+    {
+        case RACE_WORGEN:
+            barberBaseRace = RACE_HUMAN;
+            break;
+        case RACE_HIGHELF:
+            barberBaseRace = RACE_BLOODELF;
+            break;
+        case RACE_MAGHAR:
+            barberBaseRace = RACE_ORC;
+            break;
+        case RACE_GOBLIN:
+        default:
+            break;
+    }
+
+    auto IsCompatibleBarberStyle = [this, playerRace, barberBaseRace](BarberShopStyleEntry const* style, uint8 type)
+    {
+        return style && style->type == type &&
+            (style->race == playerRace || style->race == barberBaseRace) &&
+            style->gender == _player->getGender();
+    };
 
     uint32 Hair, Color, FacialHair, SkinColor;
     recvData >> Hair >> Color >> FacialHair >> SkinColor;
     BarberShopStyleEntry const* bs_hair = sBarberShopStyleStore.LookupEntry(Hair);
 
-    if (!bs_hair || bs_hair->type != 0 || bs_hair->race != _player->getRace() || bs_hair->gender != _player->getGender())
+    if (!IsCompatibleBarberStyle(bs_hair, 0))
         return;
 
     BarberShopStyleEntry const* bs_facialHair = sBarberShopStyleStore.LookupEntry(FacialHair);
 
-    if (!bs_facialHair || bs_facialHair->type != 2 || bs_facialHair->race != _player->getRace() || bs_facialHair->gender != _player->getGender())
+    if (!IsCompatibleBarberStyle(bs_facialHair, 2))
         return;
 
     BarberShopStyleEntry const* bs_skinColor = sBarberShopStyleStore.LookupEntry(SkinColor);
 
-    if (bs_skinColor && (bs_skinColor->type != 3 || bs_skinColor->race != _player->getRace() || bs_skinColor->gender != _player->getGender()))
+    if (bs_skinColor && !IsCompatibleBarberStyle(bs_skinColor, 3))
         return;
