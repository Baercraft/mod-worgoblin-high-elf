/*Updates existing starting skills to include Worgen, Goblins, and High Elves where relevant*/
/*
 * Idempotency note:
 * `racemask` is part of the primary key of playercreateinfo_skills. Updating a
 * primary-key racemask in-place can collide with a row created by a previous
 * module installation.  Each migration below therefore:
 *   1) INSERT IGNOREs the merged target row, then
 *   2) deletes only the old source row.
 * This makes install.sql safe to run again after a partial or completed import.
 */
/* I have commented out Guns for High Elves and Bows for Worgen and Goblins because other Hunters in WotLK start with only one ranged weapon skill. */
-- Bows for Orcs, Night Elves, Trolls, Blood Elves, and High Elves (650 -> 4746)
INSERT IGNORE INTO `playercreateinfo_skills` (`racemask`,`classMask`,`skill`,`rank`,`comment`)
SELECT `racemask`|4096,`classMask`,`skill`,`rank`,`comment` FROM `playercreateinfo_skills` WHERE `skill`=45 AND `racemask`=650;
DELETE FROM `playercreateinfo_skills` WHERE `skill`=45 AND `racemask`=650;

-- Guns for Dwarves, Tauren, Gnomes, Goblins, and Worgen (36 -> 2404)
INSERT IGNORE INTO `playercreateinfo_skills` (`racemask`,`classMask`,`skill`,`rank`,`comment`)
SELECT `racemask`|64|256|2048,`classMask`,`skill`,`rank`,`comment` FROM `playercreateinfo_skills` WHERE `skill`=46 AND `racemask`=36;
DELETE FROM `playercreateinfo_skills` WHERE `skill`=46 AND `racemask`=36;

-- Crossbows for Humans, Undead, and Draenei (1024 -> 1029)
INSERT IGNORE INTO `playercreateinfo_skills` (`racemask`,`classMask`,`skill`,`rank`,`comment`)
SELECT `racemask`|1|5,`classMask`,`skill`,`rank`,`comment` FROM `playercreateinfo_skills` WHERE `skill`=226 AND `racemask`=1024;
DELETE FROM `playercreateinfo_skills` WHERE `skill`=226 AND `racemask`=1024;

-- Daggers for everyone except Tauren and Draenei (735 -> 7135)
INSERT IGNORE INTO `playercreateinfo_skills` (`racemask`,`classMask`,`skill`,`rank`,`comment`)
SELECT `racemask`|256|2048|4096,`classMask`,`skill`,`rank`,`comment` FROM `playercreateinfo_skills` WHERE `skill`=173 AND `racemask`=735;
DELETE FROM `playercreateinfo_skills` WHERE `skill`=173 AND `racemask`=735;

-- 2H-maces for Humans, Dwarves, Tauren, Goblins, Draenei, and Worgen Warriors (1061 -> 3365)
INSERT IGNORE INTO `playercreateinfo_skills` (`racemask`,`classMask`,`skill`,`rank`,`comment`)
SELECT `racemask`|256|2048,`classMask`,`skill`,`rank`,`comment` FROM `playercreateinfo_skills` WHERE `skill`=160 AND `racemask`=1061;
DELETE FROM `playercreateinfo_skills` WHERE `skill`=160 AND `racemask`=1061;

/* Special cases */
INSERT IGNORE INTO `playercreateinfo_skills` (`racemask`, `classMask`, `skill`, `rank`, `comment`) VALUES
(0, 8, 173, 0, 'Daggers - Rogues'), -- Tauren and Draenei Rogues need Daggers
(0, 2, 173, 0, '2H-Maces - Paladins'); -- 2H-Maces for all Paladins

/* Add appropriate faction language to Worgen, Goblins, and High Elves. */
-- Orcish: normal Horde races + Goblin (690 -> 946)
INSERT IGNORE INTO `playercreateinfo_skills` (`racemask`,`classMask`,`skill`,`rank`,`comment`)
SELECT `racemask`|256,`classMask`,`skill`,`rank`,`comment` FROM `playercreateinfo_skills` WHERE `skill`=109 AND `racemask`=690;
DELETE FROM `playercreateinfo_skills` WHERE `skill`=109 AND `racemask`=690;

-- Common: normal Alliance races + Worgen + High Elf (1101 -> 7245)
INSERT IGNORE INTO `playercreateinfo_skills` (`racemask`,`classMask`,`skill`,`rank`,`comment`)
SELECT `racemask`|2048|4096,`classMask`,`skill`,`rank`,`comment` FROM `playercreateinfo_skills` WHERE `skill`=98 AND `racemask`=1101;
DELETE FROM `playercreateinfo_skills` WHERE `skill`=98 AND `racemask`=1101;

-- Thalassian: Blood Elf + High Elf (512 -> 4608)
INSERT IGNORE INTO `playercreateinfo_skills` (`racemask`,`classMask`,`skill`,`rank`,`comment`)
SELECT `racemask`|4096,`classMask`,`skill`,`rank`,`comment` FROM `playercreateinfo_skills` WHERE `skill`=137 AND `racemask`=512;
DELETE FROM `playercreateinfo_skills` WHERE `skill`=137 AND `racemask`=512;

/* Add racial skills */
DELETE FROM `playercreateinfo_skills` WHERE `raceMask` IN (256, 2048, 4096, 8192) AND `classMask` = 0;
INSERT IGNORE INTO `playercreateinfo_skills` (`raceMask`, `classMask`, `skill`, `rank`, `comment`) VALUES
(256, 0, 790, 0, 'Goblin - Racial'),
(2048, 0, 789, 0, 'Worgen - Racial'),
(4096, 0, 791, 0, 'High Elf - Racial'),
(8192,0,792,0,'Maghar - Racial');

/*
 * Maghar: inherit Orc eligibility for language, weapons, armor and class skill
 * lines by adding RaceMask 8192 to rows that already include Orc (bit 2).
 * Skill 125 (Orc - Racial) is intentionally excluded: Maghar uses skill 792
 * and its own racial spells instead of the normal Orc racial set.
 *
 * As above, migrate via INSERT IGNORE + DELETE so rerunning the installer does
 * not collide with the playercreateinfo_skills primary key.
 */
INSERT IGNORE INTO `playercreateinfo_skills` (`racemask`,`classMask`,`skill`,`rank`,`comment`)
SELECT `racemask`| 8192,`classMask`,`skill`,`rank`,`comment`
FROM `playercreateinfo_skills`
WHERE (`racemask` & 2) <> 0 AND (`racemask` & 8192) = 0 AND `skill` <> 125;

DELETE FROM `playercreateinfo_skills`
WHERE (`racemask` & 2) <> 0 AND (`racemask` & 8192) = 0 AND `skill` <> 125;
-- END base/playercreateinfo_skills.sql

