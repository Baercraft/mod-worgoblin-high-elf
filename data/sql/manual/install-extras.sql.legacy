/* Grants all newly created worgen and goblin rogues the ability to use their respective starting weapons */
/* Worgen and goblin rogues start with an axe and a mace, respectively, but rogues don't start with those weapon skills learned by default */
DELETE FROM `playercreateinfo_skills` WHERE `raceMask` IN (256, 2048) AND `classMask` = 8;
INSERT INTO `playercreateinfo_skills` (`raceMask`, `classMask`, `skill`, `rank`, `comment`) VALUES
(256, 8, 54, 0, 'Maces - Goblin'), -- Yes, these are hackfixes and I'm very mad about it,
(2048, 8, 44, 0, 'Axes - Worgen'); -- but right now I don't see any other way to add these.
-- END extra/cataclysm-starting-gear.sql

SET SQL_MODE=@OLD_SQL_MODE;
